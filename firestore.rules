rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validOfferGenerations(g) {
      return g is map
        && g.keys().hasOnly(['s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9', 's10', 's11'])
        && g.s0 is int && g.s0 >= 0 && g.s1 is int && g.s1 >= 0
        && g.s2 is int && g.s2 >= 0 && g.s3 is int && g.s3 >= 0
        && g.s4 is int && g.s4 >= 0 && g.s5 is int && g.s5 >= 0
        && g.s6 is int && g.s6 >= 0 && g.s7 is int && g.s7 >= 0
        && g.s8 is int && g.s8 >= 0 && g.s9 is int && g.s9 >= 0
        && g.s10 is int && g.s10 >= 0 && g.s11 is int && g.s11 >= 0;
    }

    function advancesOneOffer(before, after) {
      return (after.diff(before).affectedKeys().hasOnly(['s0']) && after.s0 == before.s0 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s1']) && after.s1 == before.s1 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s2']) && after.s2 == before.s2 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s3']) && after.s3 == before.s3 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s4']) && after.s4 == before.s4 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s5']) && after.s5 == before.s5 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s6']) && after.s6 == before.s6 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s7']) && after.s7 == before.s7 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s8']) && after.s8 == before.s8 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s9']) && after.s9 == before.s9 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s10']) && after.s10 == before.s10 + 1)
        || (after.diff(before).affectedKeys().hasOnly(['s11']) && after.s11 == before.s11 + 1);
    }

    // Informações públicas necessárias para ranking, cidades e mapa multiplayer.
    // Somente o próprio jogador pode criar ou atualizar sua presença.
    match /players/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsDocument(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Progresso privado: saldo, entregas, caminhões, empréstimo e histórico.
    // Nenhum outro jogador pode consultar ou alterar estes dados.
    match /progress/{userId} {
      allow read: if ownsDocument(userId);
      allow create, update: if ownsDocument(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Atividade diária agregada por jogador para o mercado fictício.
    match /marketActivity/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.counts is map;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == resource.data.day
        && request.resource.data.counts is map;
      allow delete: if false;
    }
    // Balanço permanente do mercado: cada jogador altera somente seu agregado.
    match /marketBalance/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsDocument(userId)
        && request.resource.data.uid == userId
        && request.resource.data.adjustments is map
        && request.resource.data.selections is map;
      allow delete: if false;
    }
    // Estoque diário global com 12 vagas fixas. Cada reserva avança somente
    // a geração da vaga escolhida e a substitui por outra da mesma distância.
    match /dailyOffers/{offerId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'city', 'round', 'generations', 'updatedAt'])
        && request.resource.data.day is string
        && request.resource.data.city is string
        && request.resource.data.round == 1
        && validOfferGenerations(request.resource.data.generations);
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'city', 'round', 'generations', 'updatedAt'])
        && request.resource.data.day == resource.data.day
        && request.resource.data.city == resource.data.city
        && request.resource.data.round == resource.data.round + 1
        && validOfferGenerations(request.resource.data.generations)
        && ((resource.data.keys().hasAny(['generations'])
          && validOfferGenerations(resource.data.generations)
          && advancesOneOffer(resource.data.generations, request.resource.data.generations))
        || !resource.data.keys().hasAny(['generations']));
      allow delete: if false;
    }
    // Mensagens privadas entre jogadores. Somente participantes podem ler;
    // o remetente cria e participantes podem apenas atualizar o estado de leitura.
    match /messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderPhoto', 'recipientId', 'recipientName', 'participantIds', 'body', 'createdAt', 'createdAtMs', 'readBy'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.recipientId in request.resource.data.participantIds
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if false;
    }
    // Tudo que não estiver explicitamente autorizado acima permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
