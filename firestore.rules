rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Informações públicas necessárias para ranking, cidades e mapa multiplayer.
    // Somente o próprio jogador pode criar ou atualizar sua presença.
    match /players/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsDocument(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Progresso privado: saldo, entregas, caminhões, empréstimo e histórico.
    // Nenhum outro jogador pode consultar ou alterar estes dados.
    match /progress/{userId} {
      allow read: if ownsDocument(userId);
      allow create, update: if ownsDocument(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // Atividade diária agregada por jogador para o mercado fictício.
    match /marketActivity/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.counts is map;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == resource.data.day
        && request.resource.data.counts is map;
      allow delete: if false;
    }
    // Balanço permanente do mercado: cada jogador altera somente seu agregado.
    match /marketBalance/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsDocument(userId)
        && request.resource.data.uid == userId
        && request.resource.data.adjustments is map
        && request.resource.data.selections is map;
      allow delete: if false;
    }
    // Estoque diário global. Cada escrita só pode consumir uma opção válida
    // ou abrir a rodada seguinte depois que a última opção for consumida.
    match /dailyOffers/{offerId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'city', 'round', 'remaining', 'updatedAt'])
        && request.resource.data.day is string
        && request.resource.data.city is string
        && request.resource.data.round == 0
        && request.resource.data.remaining is list
        && request.resource.data.remaining.size() == 2
        && request.resource.data.remaining.hasOnly([0, 1, 2]);
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'city', 'round', 'remaining', 'updatedAt'])
        && request.resource.data.day == resource.data.day
        && request.resource.data.city == resource.data.city
        && request.resource.data.remaining is list
        && request.resource.data.remaining.hasOnly([0, 1, 2])
        && ((request.resource.data.round == resource.data.round
          && request.resource.data.remaining.size() == resource.data.remaining.size() - 1
          && request.resource.data.remaining.hasOnly(resource.data.remaining))
        || (resource.data.remaining.size() == 1
          && request.resource.data.round == resource.data.round + 1
          && request.resource.data.remaining == [0, 1, 2]));
      allow delete: if false;
    }
    // Tudo que não estiver explicitamente autorizado acima permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
